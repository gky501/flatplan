{
  "name": "flatplan-desktop",
  "version": "1.0.0",
  "description": "Self-hosted publication planning for macOS",
  "author": "Flatplan",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.flatplan.desktop",
    "productName": "Flatplan",
    "asar": true,
    "files": [
      "app.js",
      "electron-main.js",
      "index.html",
      "manager.js",
      "mems.css",
      "preload.js",
      "styles.css"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Flatplan ${version}"
    }
  }
}
